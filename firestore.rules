rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ──────────────────────────────────────────────
    match /users/{uid} {
      allow read:  if request.auth != null;
      allow write: if request.auth.uid == uid;
    }

    // ── Purchase Orders ────────────────────────────────────
    match /purchase_orders/{poId} {
      // Dapur bisa buat PO baru
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'dapur';
      // Semua user authenticated bisa baca
      allow read: if request.auth != null;
      // Update: dapur bisa update PO miliknya; supplier bisa update semua (approval)
      allow update: if request.auth != null;
    }

    // ── Deliveries ─────────────────────────────────────────
    match /deliveries/{id} {
      allow read, write: if request.auth != null;
    }

    // ── QC Reports ─────────────────────────────────────────
    match /qc_reports/{id} {
      allow read, write: if request.auth != null;
    }

    // ── Menu Plans (per user) ──────────────────────────────
    match /menu_plans/{uid}/{planId} {
      allow read, write: if request.auth.uid == uid;
    }
  }
}
